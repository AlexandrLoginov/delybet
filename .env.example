# Скопируй в переменные окружения хостинга (Vercel → Settings → Environment Variables).
# Локально: cp .env.example .env.local и подставь значения.

DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

ANTHROPIC_API_KEY=""
# Идентификатор модели Anthropic Messages API (если пусто — используется значение по умолчанию из кода).
ANTHROPIC_MODEL=""
API_SPORTS_KEY=""
NEWS_API_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

NEXT_PUBLIC_SUPPORT_URL=""

# Telegram Web App: токен бота из @BotFather (для POST /api/telegram/verify — проверка initData).
TELEGRAM_BOT_TOKEN=""
# Публичная ссылка на бота (t.me/...). Если пусто — в профиле используется https://t.me/delybet_bot.
NEXT_PUBLIC_TELEGRAM_BOT_URL=""

# Для продакшен-демо без внешних API:
# NEXT_PUBLIC_USE_MOCKS=true
