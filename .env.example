# Локально: cp .env.example .env.local

# ── База (обязательно для сессии и Stripe-стран) ─────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Подпись httpOnly-сессии после Telegram (минимум 16 символов)
SESSION_SECRET=""

# Публичный URL приложения (редиректы Stripe)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── ИИ и спорт (боевой режим) ──────────────────────────────────────────────────
# Ключ: dashboard.api-football.com → тот же ключ в API_SPORTS_KEY
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
API_SPORTS_KEY=""
# Альтернативное имя (тот же ключ)
# API_FOOTBALL_KEY=""
NEWS_API_KEY=""
# Опционально: сезон API-Football (YYYY), лиги (ID через запятую), горизонт дней
# API_FOOTBALL_SEASON="2024"
# API_FOOTBALL_LEAGUE_IDS="2,39,140,135,78,61"
# API_FOOTBALL_UPCOMING_DAYS="3"
# Диагностика: GET /api/integrations/status

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

NEXT_PUBLIC_SUPPORT_URL=""

# Telegram Mini App
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_URL=""

# Моки (без внешних API): NEXT_PUBLIC_USE_MOCKS=true
# NEXT_PUBLIC_USE_MOCKS=true

# ── Stripe (оплата Pro) ─────────────────────────────────────────────────────────
# 1) dashboard.stripe.com → Developers → API keys → Secret key (sk_test_… / sk_live_…)
STRIPE_SECRET_KEY=""
# 2) Products → создай «DelyBet Pro» → 4 recurring Price (RUB, monthly interval ×1/3/6/12)
#    Суммы как в src/lib/renewal-packages.ts (499 / 1319 / 2339 / 3999 ₽ за период)
#    Скопируй price_… в переменные ниже:
STRIPE_PRICE_PRO_1M=""
STRIPE_PRICE_PRO_3M=""
STRIPE_PRICE_PRO_6M=""
STRIPE_PRICE_PRO_12M=""
# 3) Локально: npm run stripe:listen → whsec_… в STRIPE_WEBHOOK_SECRET
#    Прод: Developers → Webhooks → https://<домен>/api/stripe/webhook
#    События: checkout.session.completed, customer.subscription.created|updated|deleted
STRIPE_WEBHOOK_SECRET=""
# 4) Settings → Billing → Customer portal: отмена, смена плана (сохранить)
# Publishable key (pk_…) в этом проекте не нужен — Checkout Hosted на стороне Stripe.
# Диагностика: GET /api/stripe/status (без секретов)

# ── PayOS (Вьетнам: VietQR, Momo) ─────────────────────────────────────────────
# PAYOS_CLIENT_ID=""
# PAYOS_API_KEY=""
# PAYOS_CHECKSUM_KEY=""
# Webhook: https://<домен>/api/payos/webhook
# GET /api/payments/methods?locale=vi

# ── Только локальная разработка ─────────────────────────────────────────────────
# Показывает переключатель «Режим Pro (тест)» и позволяет ?pro=true в dev
NEXT_PUBLIC_ENABLE_DEV_TOOLS=""
